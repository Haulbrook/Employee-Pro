# SENTINEL — credentials and instance configuration
# Copied to /opt/sentinel/.env at install time and locked to mode 0600.
# DO NOT commit this file with values filled in.

# ---------- AI providers ----------
# At least one of ANTHROPIC_API_KEY or OPENAI_API_KEY must be set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------- Task queue (Google Apps Script web app) ----------
# Deployed URL of the GAS web app from layer2-agent/gas/Code.gs
GAS_ENDPOINT_URL=

# Shared secret validated by the GAS endpoint (Gate-2 FIX 6 / CT-18).
# Generate with:  python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SENTINEL_SECRET=

# ---------- Instance identity ----------
SENTINEL_INSTANCE_ID=SENTINEL-01

# ---------- Output channels (all optional) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

SLACK_WEBHOOK_URL=
