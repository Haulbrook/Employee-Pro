[Unit]
Description=SENTINEL health check (Layer 1) — invoked by sentinel-health.timer
After=network.target

[Service]
Type=oneshot
User=sentinel
Group=sentinel
Environment=SENTINEL_HOME=/opt/sentinel
ExecStart=/opt/sentinel/layer1-foundation/health-monitor.sh --once
StandardOutput=append:/var/log/sentinel/health.log
StandardError=append:/var/log/sentinel/health.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/sentinel/data /var/log/sentinel
ProtectHome=true
