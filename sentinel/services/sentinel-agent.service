[Unit]
Description=SENTINEL agent — task queue + AI engine (Layer 2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentinel
Group=sentinel
WorkingDirectory=/opt/sentinel
EnvironmentFile=-/opt/sentinel/.env
Environment=SENTINEL_HOME=/opt/sentinel
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/sentinel/.venv/bin/python /opt/sentinel/layer2-agent/task_queue.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/sentinel/agent.log
StandardError=append:/var/log/sentinel/agent.log

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/sentinel/data /var/log/sentinel
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
